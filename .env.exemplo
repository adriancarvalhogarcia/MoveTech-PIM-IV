# Copie este arquivo para ".env" (mesma pasta) e troque os valores.
# O arquivo .env NÃO vai para o Git (está no .gitignore).
MYSQL_ROOT_PASSWORD=troque-esta-senha
# Mínimo de 32 caracteres. Gere uma aleatória, por exemplo no PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_KEY=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres
